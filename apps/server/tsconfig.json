{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./dist",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["node"],
    "paths": {
      "@wbs-tool/shared": ["../../packages/shared/src/index.ts"],
      "@wbs-tool/shared/*": ["../../packages/shared/src/*"]
    },
    "baseUrl": ".",
    "allowImportingTsExtensions": false
  },
  "include": ["src/**/*.ts", "tests/**/*.ts", "../../packages/shared/src/**/*.ts"]
}
